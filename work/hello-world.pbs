#!/bin/bash
#PBS -N hello_world
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:01:00
#PBS -j oe
#PBS -o hello_world.out
#PBS -A NRAL0032

# Fail fast on errors (optional but good practice)
set -euo pipefail

echo "Hello, World!"
echo "Job ID      : $PBS_JOBID"
echo "Job Name    : $PBS_JOBNAME"
echo "Run Host    : $(hostname)"
echo "Working Dir : $PBS_O_WORKDIR"
echo "Start Time  : $(date)"
